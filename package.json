{
  "name": "omnidev",
  "version": "0.1.0",
  "private": true,
  "description": "OmniDev — agentic PR and developer workflow toolkit",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "mcp:bitbucket": "npm run mcp -w @omnidev/mcp-bitbucket",
    "mcp:github": "npm run mcp -w @omnidev/mcp-github",
    "mcp:paths": "node scripts/print-mcp-paths.mjs",
    "check:auth": "npm run check:auth -w @omnidev/mcp-bitbucket"
  },
  "engines": {
    "node": ">=20"
  }
}
