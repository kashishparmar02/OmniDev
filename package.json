{
  "name": "omnidev",
  "version": "0.1.0",
  "private": true,
  "description": "OmniDev — agentic PR and developer workflow toolkit",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
