{
  "name": "@omnidev/mcp-github",
  "version": "0.1.0",
  "description": "OmniDev GitHub MCP — author PR workflow (review tools planned)",
  "type": "module",
  "private": true,
  "bin": {
    "omnidev-github-mcp": "./bin/run-mcp.sh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "mcp": "node dist/mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@omnidev/core": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
