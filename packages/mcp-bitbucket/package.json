{
  "name": "@omnidev/mcp-bitbucket",
  "version": "0.1.0",
  "description": "OmniDev Bitbucket Cloud MCP server for PR review and comment publishing",
  "type": "module",
  "private": true,
  "bin": {
    "omnidev-bitbucket-mcp": "./bin/run-mcp.sh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mcp": "bash ./bin/run-mcp.sh",
    "start": "bash ./bin/run-mcp.sh",
    "cli": "bash ./bin/run-cli.sh",
    "check:auth": "bash ./bin/run-cli.sh auth",
    "check:pr": "bash ./bin/run-cli.sh pr"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@omnidev/core": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
