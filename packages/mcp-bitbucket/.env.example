# Optional local file — same keys can live in Cursor mcp.json "env" (those win over this file).
# Copy to .env for npm run mcp / CLI. Do not commit .env.

# Atlassian account email (used for Bitbucket API Basic auth)
BITBUCKET_EMAIL=you@ei.study

# Bitbucket username from Personal settings (case-sensitive; used for HTTPS git if needed)
BITBUCKET_USERNAME=your-bitbucket-username

# Bitbucket API token with scopes:
#   read:repository:bitbucket
#   read:pullrequest:bitbucket
# Optional: read:workspace:bitbucket, read:user:bitbucket
# Do NOT enable write:pullrequest:bitbucket (approve/merge)
BITBUCKET_API_TOKEN=

# Default workspace for short repo lookups
BITBUCKET_WORKSPACE=ei-india-admin

# Managed clone workspace when a repo is not already local
BITBUCKET_REVIEW_WORKSPACE=~/Developer/pr-review-workspaces

# Optional: comma-separated roots to search for existing clones (ASSET multi-repo folder)
BITBUCKET_LOCAL_REPO_ROOTS=~/Desktop/ASSET
